# Copy to .env: cp .env.example .env
# Local values only. Use a long random SECRET_KEY outside your PC.
# It also signs the JWTs, so keep it at least 32 characters long.
SECRET_KEY=local-dev-only-change-me-to-32-plus-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL in docker-compose (local test values, only used inside Docker).
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener-local

# Optional: password of the seed@example.com user made by `manage.py seed_dev`.
# Empty: the user is created but can't log in.
SEED_USER_PASSWORD=
