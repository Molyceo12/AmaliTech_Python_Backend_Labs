# Copy to .env: cp .env.example .env
# Local values only. Use a long random SECRET_KEY outside your PC.
SECRET_KEY=local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL in docker-compose (local test values, only used inside Docker).
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener-local
